# Copy this file to .env for local development.
# Do not commit real secrets or production connection strings.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=hextech_simulator
SOCKET_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opt in only when local debug artifact files are wanted. This is ignored in production.
HEXTECH_ENABLE_LOCAL_BUG_REPORT_ARTIFACTS=false

# Developer/agent harness only. Keep the real key in .env or the launching environment.
# Jev card triage never runs in the browser or gameplay runtime.
TYPESAFE_API_KEY=
# on = route with Jev; shadow = record Jev but keep Moe routing; off = skip Jev/state construction.
HEXTECH_JEV_CARD_TRIAGE_MODE=on

# Reserved for the anonymous player-token implementation.
# Generate a strong random value before enabling signed/hashed tokens.
PLAYER_TOKEN_SECRET=change-me-for-local-development

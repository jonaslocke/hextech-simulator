# Copy this file to .env for local development.
# Do not commit real secrets or production connection strings.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=hextech_simulator
SOCKET_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opt in only when local debug artifact files are wanted. This is ignored in production.
HEXTECH_ENABLE_LOCAL_BUG_REPORT_ARTIFACTS=false

# Reserved for the anonymous player-token implementation.
# Generate a strong random value before enabling signed/hashed tokens.
PLAYER_TOKEN_SECRET=change-me-for-local-development
